# Copy to .env and edit.
# Optional: lets Claude read call transcripts for scam tactics the rule engine misses.
ANTHROPIC_API_KEY=
# VG_CLAUDE_MODEL=claude-opus-5-5
# Where the Hugging Face models live (keeps them off C:)
VG_HF_HOME=K:\vgtools\hf
# "voiceguard" = our phone-trained detector; or any HF audio-classification model id
VG_DEEPFAKE_MODEL=voiceguard

# ---- Phone-number OTP sign-up (required to use the app) ----
# Demo mode (default when the Twilio keys are empty): NO SMS is sent; each code is printed in the
# server window and appended to backend\data\dev_otp.log.
# Real SMS: twilio.com -> create account -> Verify -> Services -> create a service, then fill in:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# VG_OTP_PROVIDER=twilio        (chosen automatically when TWILIO_VERIFY_SID is set)
# Optional fixed codes for demo/test numbers (no SMS), e.g. for judges or sim_second_phone.bat:
# VG_OTP_TEST_NUMBERS=+919876500002:246810,+919876500003:135790
